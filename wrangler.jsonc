{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sf-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "vars": { "BUILD_SHA": "dev" },
  "d1_databases": [
    { "binding": "DB", "database_name": "sf-shortener-prod",
      "database_id": "9f9fcf4e-95f3-4c85-a4ed-713d11ed66bf", "migrations_dir": "migrations" }
  ],
  "env": {
    "preview": {
      "name": "sf-shortener-preview",
      "workers_dev": true,
      "preview_urls": true,
      "vars": { "BUILD_SHA": "dev" },
      "d1_databases": [
        { "binding": "DB", "database_name": "sf-shortener-preview",
          "database_id": "610331b6-5ef0-4cd8-944e-c31102fe74e6", "migrations_dir": "migrations" }
      ]
    }
  }
}
